#!/usr/bin/env python3
"""Launch the private Code appearance only for the matching package/profile."""
import hashlib, json, os, pathlib, shlex, sys
home=pathlib.Path.home()
target=home/'.local/share/cupertino-glass/apps/vscode/1.139.1'
original=pathlib.Path('/usr/share/code/resources/app')
try:
    theme=(home/'.local/state/omarchy/current/theme.name').read_text().strip()
    manifest=json.loads((target/'cupertino-adapter.json').read_text())
    valid=theme in ('cupertino-dark','cupertino-light') and json.loads((original/'package.json').read_text())['version']==manifest['version']
    for relative,expected in manifest['originals'].items():
        if not valid:break
        valid=hashlib.sha256((original/relative).read_bytes()).hexdigest()==expected
    if valid and os.access(target/'bin/code',os.X_OK):
        flags=pathlib.Path(os.environ.get('XDG_CONFIG_HOME',home/'.config'))/'code-flags.conf'
        args=shlex.split(flags.read_text(),comments=True) if flags.exists() else []
        os.execv(target/'bin/code',[str(target/'bin/code'),*sys.argv[1:],*args])
except (OSError,ValueError,KeyError): pass
os.execv('/usr/bin/code',['/usr/bin/code',*sys.argv[1:]])
